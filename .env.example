# Frontend API base URL used at build time by Vite.
# Defaults to local backend.
# Examples:
# - http://localhost:8080 (direct local backend)
# - https://api.example.com (production backend)
# - /api (use nginx reverse proxy in Docker)
VITE_API_BASE_URL=http://localhost:8080
VITE_CHARACTER_SAVE_PATH=/v1/characters
